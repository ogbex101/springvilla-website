# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, no trailing slash (e.g. https://springvilla.org)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random string used to derive daily-rotated analytics salts (openssl rand -hex 32)
ANALYTICS_SALT=

# Email of the first super admin (used by `npm run seed:admin`)
SUPER_ADMIN_EMAIL=

# Optional: Postgres connection string, only needed for `npm run db:migrate` / `npm run seed`
# (Supabase > Project Settings > Database > Connection string > URI)
DATABASE_URL=
