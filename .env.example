# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon JWT. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role JWT. Server only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, no trailing slash (e.g. https://springvilla.org)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true on staging/preview: robots.txt blocks everything and every page is noindex
SITE_NOINDEX=false

# Long random string used to derive daily-rotated analytics salts (openssl rand -hex 32)
ANALYTICS_SALT=

# Email of the first super admin (used by `npm run seed:admin`)
SUPER_ADMIN_EMAIL=

# Optional: Postgres connection string, only for `npm run db:migrate` / `npm run seed`
# (Supabase > Connect > Session pooler). URL-encode special characters in the password (@ -> %40).
DATABASE_URL=

# Optional: Playwright admin tests (a central_admin account; see docs/OWNER_TODO.md)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
# Only if the test account is a super admin: the authenticator key shown at MFA setup
E2E_ADMIN_TOTP_SECRET=
